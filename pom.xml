<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.marcandreuf</groupId>
    <artifactId>java-katas</artifactId>
    <version>1.0.0.01-SNAPSHOT</version>

    <name>java-katas</name>
    <description>Exercises in Java, and a modernization track that takes them from the idiom they
        were written in to the current one.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Raised from 21 to 26 for the release-ordered track (docs/modernization/INDEX.md), which needs:
             22 for the FFM API and unnamed patterns, 24 for stream gatherers and the
             class-file API, 25 for scoped values, module imports and flexible constructor
             bodies, 26 for HTTP/3 in the HttpClient. The original concept track (docs 00 to
             11) and stages 1 to 9 still only need 21. -->
        <java.release>26</java.release>

        <junit.version>5.10.2</junit.version>
        <hamcrest.version>2.2</hamcrest.version>
        <commons.lang3.version>3.14.0</commons.lang3.version>

        <compiler.plugin.version>3.13.0</compiler.plugin.version>
        <surefire.plugin.version>3.2.5</surefire.plugin.version>
        <failsafe.plugin.version>3.2.5</failsafe.plugin.version>
        <enforcer.plugin.version>3.4.1</enforcer.plugin.version>
        <versions.plugin.version>2.16.2</versions.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Was hamcrest-all 1.3 at compile scope. Nothing in src/main uses it, so it is test only. -->
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <version>${hamcrest.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Used by one test. See docs/modernization/00-start-here.md: the import in that file still names
             commons-lang 2.x, which this dependency does not provide. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons.lang3.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
                <configuration>
                    <release>${java.release}</release>
                    <compilerArgs>
                        <arg>-parameters</arg>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.plugin.version}</version>
                <configuration>
                    <!-- The FFM exercise (docs/modernization/23) calls a restricted method. Without the
                         native-access flag the test still passes but prints four lines of
                         WARNING, and from a later release it will be blocked outright.
                         docs/modernization/23 explains why that flag exists rather than being the default. -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${failsafe.plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer.plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-maven</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>3.6.3</version>
                                </requireMavenVersion>
                                <!-- A JDK can target an older release but never a newer one, so
                                     the running JDK has to be at least java.release. Without
                                     this rule the build gets as far as javac and fails with
                                     "release version 26 not supported", which names neither the
                                     required version nor what you are running. -->
                                <requireJavaVersion>
                                    <version>[${java.release},)</version>
                                    <message>This repo compiles at --release ${java.release}, so it needs a JDK of ${java.release} or newer. Run ./scripts/check-env.sh, then "sdk install java 26.0.2+1.1-tem" and "sdk default java 26.0.2+1.1-tem". See docs/env-setup.md.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Was also declared as a dependency, which it is not. Plugin only. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>${versions.plugin.version}</version>
                <configuration>
                    <generateBackupPoms>false</generateBackupPoms>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Preview features are OFF by default and must stay that way: a class compiled with
             the preview flag refuses to load on any other JDK version, so enabling it here
             would make the build output un-runnable on the next release.

             For the preview experiments in docs/modernization/26 (structured concurrency) and docs/modernization/33;
             nothing in src/ uses a preview feature today.
             Run it with:   mvn -Ppreview verify
             Requires a JDK whose feature version equals java.release. -->
        <profile>
            <id>preview</id>
            <properties>
                <!-- Preview features compile only when the release EQUALS the running JDK's
                     feature version, so this profile follows whichever JDK is active instead
                     of the pinned release. It is a no-op while the two already agree, and
                     it is what stops a newer default JDK failing at compile time with
                     "invalid source release" when the preview flag is set. -->
                <java.release>${java.specification.version}</java.release>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <compilerArgs>
                                <arg>-parameters</arg>
                                <arg>-Xlint:all,-preview</arg>
                                <arg>--enable-preview</arg>
                            </compilerArgs>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <argLine>--enable-preview --enable-native-access=ALL-UNNAMED</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
